# Copie para .env.local (ignorado pelo Git) ou defina no painel da Vercel.
# Em produção/preview, use a UI: Settings -> Environment Variables.

# Chave da API Pública do DataJud (CNJ). OBRIGATÓRIA.
# O CNJ publica e rotaciona esta chave; sem ela o proxy responde 500 config_ausente.
# Fonte: https://datajud-wiki.cnj.jus.br/api-publica/acesso
DATAJUD_API_KEY=

# Senha compartilhada para liberar somente a consulta online (mínimo 16 caracteres).
APP_ACCESS_PASSWORD=

# Segredo aleatório para assinar cookies e pseudonimizar IPs (mínimo 32 caracteres).
# Gere, por exemplo, com: openssl rand -base64 48
SESSION_SECRET=

# Upstash Redis — contador do rate limit. A integração Vercel injeta as vars
# `UPSTASH_REDIS_KV_REST_API_URL` e `UPSTASH_REDIS_KV_REST_API_TOKEN`, aceitas
# automaticamente pelo código. As duas alternativas abaixo são para ligação manual.
# Sem Redis, DataJud continua fail-open, mas novos logins falham fechado com 503.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Limites do rate limit (opcionais; valores abaixo são os padrões do código).
# RL_CLIENTE_MIN=30
# RL_GLOBAL_MIN=300
# RL_GLOBAL_DIA=2000
# RL_LOGIN_15MIN=10
# RL_REDIS_TIMEOUT_MS=3000
