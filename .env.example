# Copie para .env.local (ignorado pelo Git) ou defina no painel da Vercel.
# Em produção/preview, use a UI: Settings -> Environment Variables.

# Chave da API Pública do DataJud (CNJ). OBRIGATÓRIA.
# O CNJ publica e rotaciona esta chave; sem ela o proxy responde 500 config_ausente.
# Fonte: https://datajud-wiki.cnj.jus.br/api-publica/acesso
DATAJUD_API_KEY=

# Senha compartilhada para liberar somente a consulta online (mínimo 16 caracteres).
APP_ACCESS_PASSWORD=

# Segredo aleatório para assinar cookies e pseudonimizar IPs (mínimo 32 caracteres).
# Gere, por exemplo, com: openssl rand -base64 48
SESSION_SECRET=

# Upstash Redis — contador do rate limit. A integração Vercel injeta as vars
# `UPSTASH_REDIS_KV_REST_API_URL` e `UPSTASH_REDIS_KV_REST_API_TOKEN`, aceitas
# automaticamente pelo código. As duas alternativas abaixo são para ligação manual.
# Sem Redis, DataJud continua fail-open, mas novos logins falham fechado com 503.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Limites do rate limit (opcionais; valores abaixo são os padrões do código).
# RL_CLIENTE_MIN=30
# RL_GLOBAL_MIN=300
# RL_GLOBAL_DIA=2000
# RL_LOGIN_15MIN=10
# RL_REDIS_TIMEOUT_MS=3000

# P2 — cota da API interna por token de serviço. RL_API_TOKEN_DIA é apenas o
# padrão de quem emite sem informar limite; cada token guarda o próprio.
# Ao contrário do tráfego manual, esta cota falha FECHADA: sem Redis, a API
# interna nega a chamada em vez de furar a cota diária da operação.
# RL_API_TOKEN_DIA=1000
# RL_API_TOKEN_MIN=60

# P0 — SSO Microsoft Entra + persistência Neon. Com todas preenchidas, o
# login por senha é desativado e /api/datajud exige identidade corporativa.
# Use os nomes M365_* já cadastrados na Vercel. Os nomes ENTRA_* legados são
# aceitos somente para compatibilidade; não configure ambos.
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
APP_BASE_URL=
DATABASE_URL=

# Domínio de e-mail aceito no login Entra. Padrão: btblue.com.br.
SSO_EMAIL_DOMINIO=

# QStash — lotes e expurgo assinado.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Endpoint regional do QStash, lido pelo próprio SDK. Obrigatório se a conta
# não estiver na região padrão: sem ele o publish responde 404 "user not found
# in this region". Copie o valor de console.upstash.com -> QStash -> Details.
QSTASH_URL=

# P1 — Resend para o digest diário. Configure somente no runtime da Vercel;
# nunca exponha estes valores no navegador, respostas, logs ou repositório.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
